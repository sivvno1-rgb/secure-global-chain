# Copy to .env for local dev. In production these come from Vault (SECURITY.md §2).
# No real secrets belong in the repo.

# Async SQLAlchemy URL (PostgreSQL via asyncpg in prod).
SGC_DATABASE_URL=postgresql+asyncpg://sgc:sgc@localhost:5432/sgc

# Keycloak / OIDC
SGC_OIDC_ISSUER=https://keycloak.local/realms/sgc
SGC_OIDC_JWKS_URL=https://keycloak.local/realms/sgc/protocol/openid-connect/certs
SGC_OIDC_AUDIENCE=secure-global-chain-api
SGC_JWKS_CACHE_TTL=3600
